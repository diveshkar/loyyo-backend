# ─── Server ───────────────────────────────────────────────────
NODE_ENV=development           # development | staging | production
PORT=5000

# ─── Database ─────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://user:pass@cluster0.mongodb.net/loyyo

# ─── JWT ───────────────────────────────────────────────────────
JWT_SECRET=your-256-bit-secret-here
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-refresh-secret-here
JWT_REFRESH_EXPIRES_IN=30d

# ─── Brevo (Email) ─────────────────────────────────────────────
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxx
BREVO_SENDER_EMAIL=no-reply@loyyo.lk
BREVO_SENDER_NAME=LOYYO

# ─── PayHere ───────────────────────────────────────────────────
PAYHERE_MERCHANT_ID=1234567
PAYHERE_SECRET=your-payhere-secret
PAYHERE_WEBHOOK_SECRET=your-webhook-secret

# ─── CORS ──────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
